{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openpractice:contract:openpractice-clinical-handoff:1.0",
  "title": "openpractice-clinical-handoff 1.0",
  "description": "Canonical message schema for the clinical handoff contract from openPractice to openChart (or another linked EHR). Owned by opensoft/openPractice-spec change define-patient-gateway-and-escalation; to be referenced by digest from the required openChart-spec companion change. Reference-only (design call DC-2): exactly the routing id (handoff_id), the EB-01 link_id, the EHR patient triple, HealthLinc's request reference, the conversation source (healthlinc or medxfactory) and conversation reference, the reply-path reference, category, urgency, timestamps, the clock policy reference, the origin and an optional split-group reference cross. openChart fetches the conversation by reference from whichever system holds it. openChart also reports a clinician's coded clinical-need marker. No message body, question text, reply text or other clinical content crosses or is stored in openPractice. Every object is closed. message_id is the idempotency key and carries no PHI. A receiver accepts any 1.x message and rejects any other MAJOR with reason unsupported_major_version.",
  "oneOf": [
    {
      "$ref": "#/$defs/handoffOffer"
    },
    {
      "$ref": "#/$defs/handoffAck"
    },
    {
      "$ref": "#/$defs/handoffUrgencyRaised"
    },
    {
      "$ref": "#/$defs/handoffStatus"
    },
    {
      "$ref": "#/$defs/clinicalNeedMarker"
    },
    {
      "$ref": "#/$defs/messageAck"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "description": "A deployment's configured, stable issuer identifier, unique across deployments and never derived from a host path (EB-02).",
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "opaqueRef": {
      "description": "Opaque reference. Carries no name, date of birth, contact detail, amount or clinical content.",
      "type": "string",
      "pattern": "^[A-Za-z0-9:_./-]{1,128}$"
    },
    "urgency": {
      "description": "Applied or proposed urgency. Ordered routine < priority < urgent. openPractice never lowers an applied urgency (ER-03).",
      "enum": [
        "routine",
        "priority",
        "urgent"
      ]
    },
    "patientRef": {
      "description": "The EHR patient triple (EHR issuer, namespace, value) taken from the EB-01 link, compared as a triple (EB-02).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "namespace",
        "value"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "healthlincRef": {
      "description": "HealthLinc's message reference: (HealthLinc issuer, healthlinc, value). openChart fetches the message body from HealthLinc over HealthLinc's own link (ruling 39).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "namespace",
        "value"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "namespace": {
          "const": "healthlinc"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "rejectReason": {
      "enum": [
        "schema_invalid",
        "unsupported_major_version",
        "link_unknown",
        "link_revoked",
        "link_in_review",
        "ehr_patient_mismatch",
        "unauthorized",
        "origin_not_verified"
      ]
    },
    "conversationRef": {
      "description": "Reference to the patient's conversation in the system that holds it: (issuer, healthlinc or medxfactory, value). Its namespace matches conversation_source. openChart fetches the conversation by this reference from that system (ruling 51).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "namespace",
        "value"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "namespace": {
          "enum": [
            "healthlinc",
            "medxfactory"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "clinicianRef": {
      "description": "openChart's opaque reference to the clinician who recorded a marker. Never a name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,128}$"
    },
    "handoffOffer": {
      "description": "openPractice offers a routed clinical item to openChart (ER-04, ER-05).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "message_id",
        "message_type",
        "issued_at",
        "issuer",
        "handoff_id",
        "link_id",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "openpractice-clinical-handoff"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "message_id": {
          "description": "Random UUID. It is the idempotency key: every retry reuses it. It never carries PHI.",
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "handoff_id": {
          "description": "The openPractice routing id; names one handoff for its whole life.",
          "$ref": "#/$defs/uuid"
        },
        "link_id": {
          "description": "The openpractice-ehr-patient-link link_id (EB-01, EB-04). A handoff is offered only on an active link that is not in identity review (ER-06).",
          "$ref": "#/$defs/uuid"
        },
        "message_type": {
          "const": "handoff.offer"
        },
        "payload": {
          "description": "Reference-only payload. It has no free-text field, so no clinical content can cross (ER-05).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ehr_patient",
            "healthlinc_message_ref",
            "conversation_source",
            "conversation_ref",
            "reply_path_ref",
            "category",
            "urgency",
            "submitted_at",
            "routed_at",
            "ack_by",
            "respond_by",
            "clock_policy",
            "origin"
          ],
          "properties": {
            "ehr_patient": {
              "$ref": "#/$defs/patientRef"
            },
            "healthlinc_message_ref": {
              "description": "HealthLinc's reference for the patient's request.",
              "$ref": "#/$defs/healthlincRef"
            },
            "conversation_source": {
              "description": "Where the conversation lives (ruling 51): healthlinc for a coach conversation, medxfactory for a medical-AI conversation.",
              "enum": [
                "healthlinc",
                "medxfactory"
              ]
            },
            "conversation_ref": {
              "$ref": "#/$defs/conversationRef"
            },
            "reply_path_ref": {
              "description": "Opaque HealthLinc reply-path reference, passed through unchanged. The clinician's reply goes from openChart to HealthLinc, never through openPractice.",
              "$ref": "#/$defs/opaqueRef"
            },
            "category": {
              "const": "clinical"
            },
            "urgency": {
              "$ref": "#/$defs/urgency"
            },
            "submitted_at": {
              "description": "When the patient submitted the message in HealthLinc.",
              "$ref": "#/$defs/timestamp"
            },
            "routed_at": {
              "description": "When openPractice applied the routing rules.",
              "$ref": "#/$defs/timestamp"
            },
            "ack_by": {
              "description": "openPractice alerts the office manager if no accepted handoff.ack arrives by this time (ER-07).",
              "$ref": "#/$defs/timestamp"
            },
            "respond_by": {
              "description": "openPractice's shadow of openChart's response clock, from the clock policy (ER-07, ER-08). openChart owns the actual clock.",
              "$ref": "#/$defs/timestamp"
            },
            "clock_policy": {
              "description": "The routing-clock policy version that set ack_by and respond_by.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy_id",
                "version",
                "approval"
              ],
              "properties": {
                "policy_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "approval": {
                  "enum": [
                    "approved",
                    "fail_closed_default"
                  ]
                }
              }
            },
            "origin": {
              "enum": [
                "intake",
                "recategorized_from_administrative",
                "split_from_mixed"
              ]
            },
            "split_group_ref": {
              "$ref": "#/$defs/opaqueRef"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "conversation_source": {
                    "const": "healthlinc"
                  }
                },
                "required": [
                  "conversation_source"
                ]
              },
              "then": {
                "properties": {
                  "conversation_ref": {
                    "properties": {
                      "namespace": {
                        "const": "healthlinc"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "conversation_source": {
                    "const": "medxfactory"
                  }
                },
                "required": [
                  "conversation_source"
                ]
              },
              "then": {
                "properties": {
                  "conversation_ref": {
                    "properties": {
                      "namespace": {
                        "const": "medxfactory"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "handoffAck": {
      "description": "openChart acknowledges each handoff (ruling 43).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "message_id",
        "message_type",
        "issued_at",
        "issuer",
        "handoff_id",
        "link_id",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "openpractice-clinical-handoff"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "message_id": {
          "description": "Random UUID. It is the idempotency key: every retry reuses it. It never carries PHI.",
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "handoff_id": {
          "description": "The openPractice routing id; names one handoff for its whole life.",
          "$ref": "#/$defs/uuid"
        },
        "link_id": {
          "description": "The openpractice-ehr-patient-link link_id (EB-01, EB-04). A handoff is offered only on an active link that is not in identity review (ER-06).",
          "$ref": "#/$defs/uuid"
        },
        "message_type": {
          "const": "handoff.ack"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acked_message_id",
            "result"
          ],
          "properties": {
            "acked_message_id": {
              "$ref": "#/$defs/uuid"
            },
            "result": {
              "description": "accepted: openChart took the item into its clinical inbox and started its response clock.",
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "accepted_at": {
              "$ref": "#/$defs/timestamp"
            },
            "reject_reason": {
              "$ref": "#/$defs/rejectReason"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "then": {
                "required": [
                  "accepted_at"
                ],
                "not": {
                  "required": [
                    "reject_reason"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "rejected"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "then": {
                "required": [
                  "reject_reason"
                ],
                "not": {
                  "required": [
                    "accepted_at"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "handoffUrgencyRaised": {
      "description": "openPractice tells openChart that an item's urgency was raised.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "message_id",
        "message_type",
        "issued_at",
        "issuer",
        "handoff_id",
        "link_id",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "openpractice-clinical-handoff"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "message_id": {
          "description": "Random UUID. It is the idempotency key: every retry reuses it. It never carries PHI.",
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "handoff_id": {
          "description": "The openPractice routing id; names one handoff for its whole life.",
          "$ref": "#/$defs/uuid"
        },
        "link_id": {
          "description": "The openpractice-ehr-patient-link link_id (EB-01, EB-04). A handoff is offered only on an active link that is not in identity review (ER-06).",
          "$ref": "#/$defs/uuid"
        },
        "message_type": {
          "const": "handoff.urgency_raised"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urgency",
            "raised_at",
            "ack_by",
            "respond_by",
            "source"
          ],
          "properties": {
            "urgency": {
              "description": "Only a raise is possible; there is no message that lowers urgency (ER-03).",
              "enum": [
                "priority",
                "urgent"
              ]
            },
            "raised_at": {
              "$ref": "#/$defs/timestamp"
            },
            "ack_by": {
              "$ref": "#/$defs/timestamp"
            },
            "respond_by": {
              "$ref": "#/$defs/timestamp"
            },
            "source": {
              "enum": [
                "healthlinc_triage",
                "staff",
                "agent_proposal",
                "routing_rule"
              ]
            }
          }
        }
      }
    },
    "handoffStatus": {
      "description": "openChart reports handoff progress. Coded only; no reply content.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "message_id",
        "message_type",
        "issued_at",
        "issuer",
        "handoff_id",
        "link_id",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "openpractice-clinical-handoff"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "message_id": {
          "description": "Random UUID. It is the idempotency key: every retry reuses it. It never carries PHI.",
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "handoff_id": {
          "description": "The openPractice routing id; names one handoff for its whole life.",
          "$ref": "#/$defs/uuid"
        },
        "link_id": {
          "description": "The openpractice-ehr-patient-link link_id (EB-01, EB-04). A handoff is offered only on an active link that is not in identity review (ER-06).",
          "$ref": "#/$defs/uuid"
        },
        "message_type": {
          "const": "handoff.status"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "status_at"
          ],
          "properties": {
            "status": {
              "description": "responded: a clinician replied to HealthLinc over openChart's reply path. clock_expired: openChart's response clock ran out. returned_not_clinical: a clinician judged the item administrative. content_unavailable: openChart could not fetch the message from HealthLinc. closed: done.",
              "enum": [
                "responded",
                "clock_expired",
                "returned_not_clinical",
                "content_unavailable",
                "closed"
              ]
            },
            "status_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      }
    },
    "clinicalNeedMarker": {
      "description": "openChart reports a clinician's clinical-need marker to openPractice on the patient's EB-01 link (ER-18).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "message_id",
        "message_type",
        "issued_at",
        "issuer",
        "link_id",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "openpractice-clinical-handoff"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "message_id": {
          "description": "Random UUID. It is the idempotency key: every retry reuses it. It never carries PHI.",
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "link_id": {
          "description": "The openpractice-ehr-patient-link link_id (EB-01, EB-04). A handoff is offered only on an active link that is not in identity review (ER-06).",
          "$ref": "#/$defs/uuid"
        },
        "message_type": {
          "const": "clinical_need.marker"
        },
        "payload": {
          "description": "A coded, attributed, time-boxed clinical-need marker. It carries no reason, note or other clinical content (ER-18).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "need_id",
            "action",
            "kind",
            "marked_by",
            "marked_at"
          ],
          "properties": {
            "need_id": {
              "$ref": "#/$defs/uuid"
            },
            "action": {
              "enum": [
                "mark",
                "withdraw"
              ]
            },
            "kind": {
              "description": "appointment_needed: a clinician judged an appointment clinically needed, so a payment hold never blocks it (PH-01). messaging_continuity: a clinician keeps clinical messaging and medical-AI consults open for continuity of care (PG-04, ruling 50).",
              "enum": [
                "appointment_needed",
                "messaging_continuity"
              ]
            },
            "marked_by": {
              "$ref": "#/$defs/clinicianRef"
            },
            "marked_at": {
              "$ref": "#/$defs/timestamp"
            },
            "valid_until": {
              "$ref": "#/$defs/timestamp"
            },
            "origin": {
              "enum": [
                "clinician_judgment",
                "urgent_escalation"
              ]
            },
            "related_handoff_id": {
              "description": "The routing id of the urgent handoff the need arose from. openPractice honors an urgent_escalation origin only when its own routing record shows that id as urgent on this link (ER-18).",
              "$ref": "#/$defs/uuid"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "mark"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "required": [
                  "valid_until",
                  "origin"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "withdraw"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "valid_until"
                      ]
                    },
                    {
                      "required": [
                        "origin"
                      ]
                    },
                    {
                      "required": [
                        "related_handoff_id"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "origin": {
                    "const": "urgent_escalation"
                  }
                },
                "required": [
                  "origin"
                ]
              },
              "then": {
                "required": [
                  "related_handoff_id"
                ]
              }
            }
          ]
        }
      }
    },
    "messageAck": {
      "description": "Acknowledges handoff.urgency_raised, handoff.status and clinical_need.marker. handoff_id is present except for a marker that names no handoff.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "message_id",
        "message_type",
        "issued_at",
        "issuer",
        "link_id",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "openpractice-clinical-handoff"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "message_id": {
          "description": "Random UUID. It is the idempotency key: every retry reuses it. It never carries PHI.",
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issuer": {
          "$ref": "#/$defs/issuer"
        },
        "correlation_id": {
          "$ref": "#/$defs/uuid"
        },
        "handoff_id": {
          "description": "The openPractice routing id; names one handoff for its whole life.",
          "$ref": "#/$defs/uuid"
        },
        "link_id": {
          "description": "The openpractice-ehr-patient-link link_id (EB-01, EB-04). A handoff is offered only on an active link that is not in identity review (ER-06).",
          "$ref": "#/$defs/uuid"
        },
        "message_type": {
          "const": "message.ack"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acked_message_id",
            "result"
          ],
          "properties": {
            "acked_message_id": {
              "$ref": "#/$defs/uuid"
            },
            "result": {
              "enum": [
                "received",
                "rejected"
              ]
            },
            "reject_reason": {
              "$ref": "#/$defs/rejectReason"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "rejected"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "then": {
                "required": [
                  "reject_reason"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
