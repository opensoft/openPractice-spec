{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:openpractice:contract:openpractice-agent-operations:1.0",
 "title": "openpractice-agent-operations 1.0",
 "description": "Canonical schema for the agent operations contract (define-actors-agents-and-work-inbox, AO-01). Requests, responses, autonomy settings, read-only answer types and the daily agent digest. Every agent action follows its FD-5 tier and BAB-17 of define-mvp-practice-foundation; the autonomy ladder never gives less friction than the tier (AO-04). Grants, rungs, limits and the pause are changed only by named humans, so granted_by and the digest signer are human actors (AO-03). openPractice derives untrusted contribution on the server; the agent's own flag may only raise it (AH-05). A read-only answer carries no payload: the agent selects a practice-approved answer type and openPractice assembles the reply (AH-05 exception 1). Payload content is validated against the registry operation's own schema (PR-09), defined in planning. No key, reason or digest line carries PHI. openWallet identity mechanics are decided in planning; the schema carries only an opaque reference. Five work-item operations (AO-13; ruling 93) act only on the item named by work_item_ref and never change a record: work_item.read_text returns the administrative text openPractice holds for that item (outcome read_result; a clinical item, removed text or a document has none, and is refused with text_not_held); work_item.propose_clinical_reroute and work_item.propose_urgency_raise are raise-only proposals that openPractice's fixed routing rules apply at once (outcome applied_by_rule); work_item.release_to_human gives the item to a human owner (outcome released); and work_item.cancel_pending_answer cancels the agent's own read-only answer while it is still in its cancel window (outcome cancelled). None of them rises above propose. A read-only answer is scheduled and sent only while the patient's consent to AI-authored administrative messaging is recorded (AH-06); otherwise the request is refused with consent_not_recorded.",
 "oneOf": [
  {
   "$ref": "#/$defs/request"
  },
  {
   "$ref": "#/$defs/response"
  },
  {
   "$ref": "#/$defs/autonomySetting"
  },
  {
   "$ref": "#/$defs/answerType"
  },
  {
   "$ref": "#/$defs/digest"
  }
 ],
 "$defs": {
  "ref": {
   "type": "string",
   "pattern": "^[A-Za-z0-9:_-]{1,128}$"
  },
  "uuid": {
   "type": "string",
   "format": "uuid"
  },
  "version": {
   "type": "string",
   "pattern": "^1\\.[0-9]+$"
  },
  "openWalletRef": {
   "description": "Opaque reference to the agent's openWallet ID. Verification mechanics are decided in planning.",
   "type": "string",
   "pattern": "^[A-Za-z0-9:._-]{1,256}$"
  },
  "rung": {
   "enum": [
    "observe",
    "propose",
    "act_with_notice",
    "act_after_delay"
   ]
  },
  "tier": {
   "enum": [
    "tier_1",
    "tier_2",
    "tier_3",
    "tier_4",
    "signoff_gate",
    "d8_approval"
   ]
  },
  "actionType": {
   "description": "Contract 1.0 covers the patient-registry operations, the read-only answer types (AO-11) and the five work-item operations (AO-13; ruling 93). Later features add theirs as MINOR versions.",
   "enum": [
    "patient.search",
    "patient.read",
    "patient.create",
    "patient.update_identity",
    "patient.update_preferences",
    "patient.update_contacts",
    "patient.update_confidential_instructions",
    "guarantor.set",
    "coverage.add",
    "coverage.update",
    "patient.deactivate",
    "patient.reactivate",
    "patient.hard_delete",
    "patient_answer.coverage_on_file",
    "patient_answer.balance",
    "patient_answer.appointment_time",
    "patient_answer.practice_information",
    "work_item.read_text",
    "work_item.propose_clinical_reroute",
    "work_item.propose_urgency_raise",
    "work_item.release_to_human",
    "work_item.cancel_pending_answer"
   ]
  },
  "readOnlyAnswerType": {
   "description": "Read-only answer action types (AH-05 exception 1; rulings 45 and 46). Each changes nothing and tells the signed-in patient only their own administrative information or practice-approved information. patient_answer.appointment_time stays unavailable until a ratified scheduling change supplies appointment data (AO-11).",
   "enum": [
    "patient_answer.coverage_on_file",
    "patient_answer.balance",
    "patient_answer.appointment_time",
    "patient_answer.practice_information"
   ]
  },
  "workItemActionType": {
   "description": "The five work-item operations (AO-13; ruling 93). Each acts only on the item named by work_item_ref, carries no payload and no answer type, and never changes a record. Their autonomy setting never rises above propose (design calls D-18 to D-20).",
   "enum": [
    "work_item.read_text",
    "work_item.propose_clinical_reroute",
    "work_item.propose_urgency_raise",
    "work_item.release_to_human",
    "work_item.cancel_pending_answer"
   ]
  },
  "releaseReason": {
   "description": "Why an agent releases an item to a human owner (WI-04, AO-13; design call D-21, PROPOSED). exceeds_rung_or_cap: the action exceeds the agent's rung or the tier's cap (AO-04). untrusted_content: the action derives from untrusted content (AH-05). limit_reached: a rate or blast-radius limit stops it (AO-08). patient_asked_for_person: the item's text asks for a person (ruling 45). cannot_complete: the agent cannot complete the item.",
   "enum": [
    "exceeds_rung_or_cap",
    "untrusted_content",
    "limit_reached",
    "patient_asked_for_person",
    "cannot_complete"
   ]
  },
  "itemText": {
   "description": "The administrative text openPractice holds for the item the agent is working, returned by work_item.read_text (AO-13). In 1.0 the only text kind is administrative_inquiry: the question text that change define-patient-gateway-and-escalation stores under PG-10. A clinical inquiry carries no text into openPractice, text removed on recategorization (ER-12) no longer exists, and no change gives openPractice a store of document content, so none of these can be read. The text is untrusted content: data, never instructions (AH-05). It is never logged (AO-12).",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "item_kind",
    "text_ref",
    "text"
   ],
   "properties": {
    "item_kind": {
     "enum": [
      "administrative_inquiry"
     ]
    },
    "text_ref": {
     "description": "Opaque reference to the stored administrative communication record, citable as an evidence reference.",
     "$ref": "#/$defs/ref"
    },
    "text": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4000
    }
   }
  },
  "answerTypeRef": {
   "description": "A practice-approved answer type and its version, recorded in the audit and in the reply's attribution (AH-05 exception 1).",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "answer_type_id",
    "version"
   ],
   "properties": {
    "answer_type_id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "actor": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "roster_ref",
    "actor_type",
    "on_behalf_of"
   ],
   "properties": {
    "roster_ref": {
     "$ref": "#/$defs/ref"
    },
    "actor_type": {
     "enum": [
      "on_site_staff",
      "remote_va",
      "nurse",
      "clinician",
      "medical_director",
      "controller",
      "ai_agent",
      "system_integration"
     ]
    },
    "openwallet_ref": {
     "$ref": "#/$defs/openWalletRef"
    },
    "on_behalf_of": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "ref"
     ],
     "properties": {
      "kind": {
       "enum": [
        "practice",
        "sponsor",
        "staff_member"
       ]
      },
      "ref": {
       "$ref": "#/$defs/ref"
      }
     }
    }
   },
   "if": {
    "properties": {
     "actor_type": {
      "const": "ai_agent"
     }
    },
    "required": [
     "actor_type"
    ]
   },
   "then": {
    "required": [
     "openwallet_ref"
    ]
   }
  },
  "humanActor": {
   "description": "A named human roster entry. Never an AI agent or an integration identity (AO-03). The role check, for example the practice manager or the controller or office manager recipe, runs on the server.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "roster_ref",
    "actor_type"
   ],
   "properties": {
    "roster_ref": {
     "$ref": "#/$defs/ref"
    },
    "actor_type": {
     "enum": [
      "on_site_staff",
      "remote_va",
      "nurse",
      "clinician",
      "medical_director",
      "controller"
     ]
    }
   }
  },
  "request": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "contract",
    "contract_version",
    "message",
    "request_id",
    "idempotency_key",
    "actor",
    "action_type",
    "mode",
    "untrusted_input"
   ],
   "properties": {
    "contract": {
     "const": "openpractice-agent-operations"
    },
    "contract_version": {
     "$ref": "#/$defs/version"
    },
    "message": {
     "const": "operation.request"
    },
    "request_id": {
     "$ref": "#/$defs/uuid"
    },
    "idempotency_key": {
     "description": "Opaque; never contains per-person data (AO-06).",
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "actor": {
     "$ref": "#/$defs/actor"
    },
    "action_type": {
     "$ref": "#/$defs/actionType"
    },
    "mode": {
     "enum": [
      "dry_run",
      "execute"
     ]
    },
    "target_ref": {
     "$ref": "#/$defs/ref"
    },
    "work_item_ref": {
     "description": "The work item the agent is working. It binds the agent's reads to that item's target patient (AO-03), and it is the only item a work-item operation acts on (AO-13).",
     "$ref": "#/$defs/ref"
    },
    "payload": {
     "description": "Validated against the registry operation's own schema (PR-09).",
     "type": "object"
    },
    "answer_type": {
     "description": "The practice-approved answer type the agent selects for a read-only answer. The agent writes no free text (AH-05 exception 1).",
     "$ref": "#/$defs/answerTypeRef"
    },
    "evidence_refs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/ref"
     }
    },
    "reasoning_ref": {
     "$ref": "#/$defs/ref"
    },
    "untrusted_input": {
     "description": "The agent's own report that untrusted content contributed. It may only raise openPractice's determination, never lower it: openPractice derives untrusted contribution on the server from the provenance of each evidence reference and of the work item (AH-05).",
     "type": "boolean"
    },
    "proposed_category": {
     "description": "For work_item.propose_clinical_reroute only: clinical when the administrative item is clinical, mixed when part of it is. openPractice's fixed rules apply it at once and never route a part back to administration (AO-13; ER-12 and DC-14 of define-patient-gateway-and-escalation).",
     "enum": [
      "clinical",
      "mixed"
     ]
    },
    "proposed_urgency": {
     "description": "For work_item.propose_urgency_raise only: a raise to priority or urgent. The rules apply it at once when it is higher than the applied urgency and never lower urgency (AO-13; ER-02 and ER-03 of define-patient-gateway-and-escalation).",
     "enum": [
      "priority",
      "urgent"
     ]
    },
    "release_reason": {
     "description": "For work_item.release_to_human only (WI-04, AO-13).",
     "$ref": "#/$defs/releaseReason"
    },
    "cancels_request_id": {
     "description": "For work_item.cancel_pending_answer only: the request_id of the agent's own request that scheduled the read-only answer to be cancelled (AO-13).",
     "$ref": "#/$defs/uuid"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "actor": {
        "properties": {
         "actor_type": {
          "const": "ai_agent"
         }
        }
       },
       "mode": {
        "const": "execute"
       }
      },
      "required": [
       "actor",
       "mode"
      ]
     },
     "then": {
      "required": [
       "evidence_refs",
       "reasoning_ref"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "actor": {
        "properties": {
         "actor_type": {
          "const": "ai_agent"
         }
        }
       }
      },
      "required": [
       "actor"
      ]
     },
     "then": {
      "required": [
       "work_item_ref"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "answer_type",
       "target_ref",
       "work_item_ref"
      ],
      "not": {
       "required": [
        "payload"
       ]
      }
     }
    },
    {
     "if": {
      "required": [
       "answer_type"
      ]
     },
     "then": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/workItemActionType"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "work_item_ref"
      ],
      "not": {
       "anyOf": [
        {
         "required": [
          "payload"
         ]
        },
        {
         "required": [
          "answer_type"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.propose_clinical_reroute"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "proposed_category"
      ]
     }
    },
    {
     "if": {
      "required": [
       "proposed_category"
      ]
     },
     "then": {
      "properties": {
       "action_type": {
        "const": "work_item.propose_clinical_reroute"
       }
      },
      "required": [
       "action_type"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.propose_urgency_raise"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "proposed_urgency"
      ]
     }
    },
    {
     "if": {
      "required": [
       "proposed_urgency"
      ]
     },
     "then": {
      "properties": {
       "action_type": {
        "const": "work_item.propose_urgency_raise"
       }
      },
      "required": [
       "action_type"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.release_to_human"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "release_reason"
      ]
     }
    },
    {
     "if": {
      "required": [
       "release_reason"
      ]
     },
     "then": {
      "properties": {
       "action_type": {
        "const": "work_item.release_to_human"
       }
      },
      "required": [
       "action_type"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.cancel_pending_answer"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "cancels_request_id"
      ]
     }
    },
    {
     "if": {
      "required": [
       "cancels_request_id"
      ]
     },
     "then": {
      "properties": {
       "action_type": {
        "const": "work_item.cancel_pending_answer"
       }
      },
      "required": [
       "action_type"
      ]
     }
    }
   ]
  },
  "response": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "contract",
    "contract_version",
    "message",
    "request_id",
    "outcome"
   ],
   "properties": {
    "contract": {
     "const": "openpractice-agent-operations"
    },
    "contract_version": {
     "$ref": "#/$defs/version"
    },
    "message": {
     "const": "operation.result"
    },
    "request_id": {
     "$ref": "#/$defs/uuid"
    },
    "outcome": {
     "enum": [
      "dry_run_result",
      "proposed",
      "executed",
      "scheduled",
      "refused",
      "read_result",
      "applied_by_rule",
      "released",
      "cancelled"
     ],
     "description": "dry_run_result, proposed, executed, scheduled and refused as before. read_result: work_item.read_text returned item_text and changed nothing. applied_by_rule: openPractice's fixed routing rules took in the agent's raise-only re-route or urgency proposal at once; the agent did not act. released: the item now has a human owner. cancelled: the agent's pending read-only answer was cancelled before it was sent (AO-13)."
    },
    "action_type": {
     "$ref": "#/$defs/actionType"
    },
    "untrusted_content": {
     "description": "openPractice's own determination, from provenance, of whether untrusted content contributed (AH-05). Never taken from the agent's flag alone.",
     "type": "boolean"
    },
    "answer_type": {
     "$ref": "#/$defs/answerTypeRef"
    },
    "tier": {
     "$ref": "#/$defs/tier"
    },
    "rung_applied": {
     "$ref": "#/$defs/rung"
    },
    "signoff_required": {
     "enum": [
      "none",
      "authorized_signer",
      "named_human",
      "accountant"
     ]
    },
    "work_item_ref": {
     "$ref": "#/$defs/ref"
    },
    "executes_at": {
     "type": "string",
     "format": "date-time"
    },
    "refusal_reason": {
     "enum": [
      "schema_invalid",
      "unsupported_major_version",
      "actor_unknown",
      "principal_missing",
      "sponsor_inactive",
      "no_grant",
      "rung_cap",
      "untrusted_content_cap",
      "gate_not_met",
      "evidence_missing",
      "idempotency_conflict",
      "operation_not_supported",
      "rate_limited",
      "blast_radius",
      "paused",
      "signoff_required",
      "patient_scope",
      "answer_ineligible",
      "phi_access_suspended",
      "text_not_held",
      "answer_not_pending",
      "consent_not_recorded"
     ]
    },
    "item_text": {
     "$ref": "#/$defs/itemText"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "refused"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "refusal_reason"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "proposed"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "work_item_ref",
       "signoff_required"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "scheduled"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "executes_at",
       "work_item_ref"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "tier": {
        "enum": [
         "tier_4",
         "d8_approval"
        ]
       },
       "outcome": {
        "enum": [
         "executed",
         "scheduled"
        ]
       }
      },
      "required": [
       "tier",
       "outcome"
      ]
     },
     "then": false
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "enum": [
         "proposed",
         "executed",
         "scheduled",
         "applied_by_rule",
         "released",
         "cancelled"
        ]
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "untrusted_content"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "untrusted_content": {
        "const": true
       }
      },
      "required": [
       "untrusted_content"
      ]
     },
     "then": {
      "not": {
       "properties": {
        "outcome": {
         "const": "executed"
        }
       },
       "required": [
        "outcome"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "untrusted_content": {
        "const": true
       },
       "outcome": {
        "const": "scheduled"
       }
      },
      "required": [
       "untrusted_content",
       "outcome"
      ]
     },
     "then": {
      "required": [
       "action_type",
       "rung_applied",
       "answer_type"
      ],
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       },
       "rung_applied": {
        "const": "act_after_delay"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "not": {
       "properties": {
        "outcome": {
         "const": "executed"
        }
       },
       "required": [
        "outcome"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       },
       "outcome": {
        "const": "scheduled"
       }
      },
      "required": [
       "action_type",
       "outcome"
      ]
     },
     "then": {
      "required": [
       "answer_type",
       "rung_applied"
      ],
      "properties": {
       "rung_applied": {
        "const": "act_after_delay"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.read_text"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "outcome": {
        "enum": [
         "read_result",
         "dry_run_result",
         "refused"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.propose_clinical_reroute"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "outcome": {
        "enum": [
         "applied_by_rule",
         "dry_run_result",
         "refused"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.propose_urgency_raise"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "outcome": {
        "enum": [
         "applied_by_rule",
         "dry_run_result",
         "refused"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.release_to_human"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "outcome": {
        "enum": [
         "released",
         "dry_run_result",
         "refused"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "work_item.cancel_pending_answer"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "outcome": {
        "enum": [
         "cancelled",
         "dry_run_result",
         "refused"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "read_result"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "action_type",
       "item_text"
      ],
      "properties": {
       "action_type": {
        "enum": [
         "work_item.read_text"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "applied_by_rule"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "action_type",
       "work_item_ref"
      ],
      "properties": {
       "action_type": {
        "enum": [
         "work_item.propose_clinical_reroute",
         "work_item.propose_urgency_raise"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "released"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "action_type",
       "work_item_ref"
      ],
      "properties": {
       "action_type": {
        "enum": [
         "work_item.release_to_human"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "outcome": {
        "const": "cancelled"
       }
      },
      "required": [
       "outcome"
      ]
     },
     "then": {
      "required": [
       "action_type",
       "work_item_ref"
      ],
      "properties": {
       "action_type": {
        "enum": [
         "work_item.cancel_pending_answer"
        ]
       }
      }
     }
    },
    {
     "if": {
      "required": [
       "item_text"
      ]
     },
     "then": {
      "properties": {
       "outcome": {
        "const": "read_result"
       }
      },
      "required": [
       "outcome"
      ]
     }
    }
   ]
  },
  "autonomySetting": {
   "description": "One action type's rung for one agent; for a read-only answer type, one answer type's rung. Only a named human sets it (AO-03). Raising a rung above propose is the BAB-17 agent-signing opt-in. Tier-4 operations never rise above propose; a read-only answer type rises only to act_after_delay. A work-item operation (AO-13) never rises above propose: it reads, proposes a raise-only change that the routing rules apply, or puts the item before a human.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "document",
    "agent_roster_ref",
    "openwallet_ref",
    "action_type",
    "rung",
    "granted_by",
    "effective_from",
    "version"
   ],
   "properties": {
    "document": {
     "const": "autonomy_setting"
    },
    "agent_roster_ref": {
     "$ref": "#/$defs/ref"
    },
    "openwallet_ref": {
     "$ref": "#/$defs/openWalletRef"
    },
    "action_type": {
     "$ref": "#/$defs/actionType"
    },
    "rung": {
     "$ref": "#/$defs/rung"
    },
    "answer_type": {
     "$ref": "#/$defs/answerTypeRef"
    },
    "cancel_window_minutes": {
     "description": "The practice-set delay window that the item's lane can cancel, for a read-only answer at act_after_delay (AH-05 exception 1).",
     "type": "integer",
     "minimum": 1
    },
    "granted_by": {
     "$ref": "#/$defs/humanActor"
    },
    "effective_from": {
     "type": "string",
     "format": "date"
    },
    "effective_to": {
     "type": "string",
     "format": "date"
    },
    "version": {
     "type": "integer",
     "minimum": 1
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "action_type": {
        "const": "patient.hard_delete"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "rung": {
        "enum": [
         "observe",
         "propose"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "required": [
       "answer_type"
      ],
      "properties": {
       "rung": {
        "enum": [
         "observe",
         "propose",
         "act_after_delay"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       },
       "rung": {
        "const": "act_after_delay"
       }
      },
      "required": [
       "action_type",
       "rung"
      ]
     },
     "then": {
      "required": [
       "cancel_window_minutes"
      ]
     }
    },
    {
     "if": {
      "required": [
       "answer_type"
      ]
     },
     "then": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/readOnlyAnswerType"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "action_type": {
        "$ref": "#/$defs/workItemActionType"
       }
      },
      "required": [
       "action_type"
      ]
     },
     "then": {
      "properties": {
       "rung": {
        "enum": [
         "observe",
         "propose"
        ]
       }
      }
     }
    }
   ]
  },
  "answerType": {
   "description": "A practice-approved, versioned read-only answer type (AH-05 exception 1). The template text is held in openPractice. A named human approves each answer type and template version, and anything health-adjacent also needs the medical director's sign-off; neither approval is ever opted in for agent signing.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "document",
    "answer_type_id",
    "version",
    "action_type",
    "template_ref",
    "template_version",
    "allowlisted_fields",
    "topics",
    "health_adjacent",
    "approved_by",
    "approved_at"
   ],
   "properties": {
    "document": {
     "const": "answer_type"
    },
    "answer_type_id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
     "type": "integer",
     "minimum": 1
    },
    "action_type": {
     "$ref": "#/$defs/readOnlyAnswerType"
    },
    "template_ref": {
     "$ref": "#/$defs/ref"
    },
    "template_version": {
     "type": "integer",
     "minimum": 1
    },
    "allowlisted_fields": {
     "description": "Coded fields of the bound patient's own record that the template may fill. Empty for practice-approved information.",
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
     }
    },
    "topics": {
     "description": "The practice's allowlisted administrative topics for this answer type, drawn from the gateway's topic codes (define-patient-gateway-and-escalation). records_request and demographics are excluded, because records requests and identity-revealing answers never qualify.",
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "scheduling",
       "billing_statement",
       "payment",
       "coverage",
       "forms",
       "general"
      ]
     }
    },
    "health_adjacent": {
     "type": "boolean"
    },
    "approved_by": {
     "$ref": "#/$defs/humanActor"
    },
    "approved_at": {
     "type": "string",
     "format": "date-time"
    },
    "medical_director_signoff": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "roster_ref",
      "actor_type",
      "signed_at"
     ],
     "properties": {
      "roster_ref": {
       "$ref": "#/$defs/ref"
      },
      "actor_type": {
       "const": "medical_director"
      },
      "signed_at": {
       "type": "string",
       "format": "date-time"
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "health_adjacent": {
        "const": true
       }
      },
      "required": [
       "health_adjacent"
      ]
     },
     "then": {
      "required": [
       "medical_director_signoff"
      ]
     }
    }
   ]
  },
  "digest": {
   "description": "Daily agent digest (AO-10): counts only, no PHI. Signed in the day close by the controller or office manager.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "document",
    "day",
    "entries"
   ],
   "properties": {
    "document": {
     "const": "agent_digest"
    },
    "day": {
     "type": "string",
     "format": "date"
    },
    "entries": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "agent_roster_ref",
       "action_type",
       "counts"
      ],
      "properties": {
       "agent_roster_ref": {
        "$ref": "#/$defs/ref"
       },
       "action_type": {
        "$ref": "#/$defs/actionType"
       },
       "counts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "proposed": {
          "type": "integer",
          "minimum": 0
         },
         "executed": {
          "type": "integer",
          "minimum": 0
         },
         "scheduled": {
          "type": "integer",
          "minimum": 0
         },
         "cancelled": {
          "type": "integer",
          "minimum": 0
         },
         "refused": {
          "type": "integer",
          "minimum": 0
         },
         "approved": {
          "type": "integer",
          "minimum": 0
         },
         "rejected": {
          "type": "integer",
          "minimum": 0
         },
         "read_result": {
          "type": "integer",
          "minimum": 0
         },
         "applied_by_rule": {
          "type": "integer",
          "minimum": 0
         },
         "released": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      }
     }
    },
    "signed_by": {
     "$ref": "#/$defs/humanActor"
    },
    "signed_at": {
     "type": "string",
     "format": "date-time"
    }
   }
  }
 }
}
